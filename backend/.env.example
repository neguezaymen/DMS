NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (Neon) — URL unique
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# OpenAI (embeddings text-embedding-3-small + chat) — optionnel : repli local sinon
OPENAI_API_KEY=

JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

RESET_PASSWORD_URL=http://localhost:5173/reset-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mon.email@gmail.com
SMTP_PASS=xxxx
SMTP_FROM="DMS Workspace <mon.email@gmail.com>"
